{
  "fyn": {
    "options": {
      "sourceMaps": false,
      "layout": "detail"
    }
  },
  "packages": ["packages/*", "_w/*"],
  "command": {
    "publish": {
      "tags": {
        "v2": {
          "enabled": true,
          "packages": {
            "fynpo": true,
            "fyn": true
          }
        }
      },
      "_comment_excludePackages": [
        "_w/* holds vendored forks whose package names (ignore-walk, npm-packlist)",
        "belong to other publishers on the public registry. They are working copies,",
        "never ours to publish - keep them out of the release set."
      ],
      "excludePackages": ["path:_w/*"]
    }
  },
  "ignore": ["packages/pacote-jchip"],
  "caching": {
    "enable": true,
    "server": "http://localhost:8080/upload",
    "pruning": {
      "highCount": 12,
      "keepCount": 6
    },
    "alwaysUploadToRemote": true
  },
  "packageCache": {
    "default": {
      "input": {
        "npmScripts": ["prepare", "prepublish", "build:release", "build"],
        "include": ["**/*"],
        "exclude": [
          "**/?(node_modules|.vscode|.DS_Store|coverage|.nyc_output|.fynpo|.git|.github|.gitignore|docs|docusaurus|packages|tmp|.etmp|samples|dist|dist-*|build)",
          "**/*.?(log|md)"
        ],
        "includeEnv": ["NODE_ENV"],
        "includeVersions": ["node"]
      },
      "output": {
        "include": "",
        "filesFromNpmPack": true,
        "exclude": [
          "**/?(node_modules|.vscode|.DS_Store|coverage|.nyc_output|.fynpo|src|docusaurus)",
          "**/*.log"
        ]
      }
    }
  },
  "lifecycleCache": {
    "default": {
      "input": {
        "npmScripts": ["test", "coverage", "ci:check"],
        "include": ["**/*"],
        "exclude": [
          "**/?(node_modules|.vscode|.DS_Store|coverage|.nyc_output|.fynpo|.git|.github|.gitignore|docs|docusaurus|packages|tmp|.etmp|samples|dist|dist-*|build)",
          "**/*.?(log|md)",
          "**/.fynpo-data.json"
        ],
        "includeEnv": ["NODE_ENV"],
        "includeVersions": ["node"]
      },
      "output": {
        "include": ["coverage"],
        "exclude": []
      }
    }
  }
}
